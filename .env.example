# ---- Základ -----------------------------------------------------------------
PORT=3000
# Veřejná adresa aplikace – použije se v ověřovacích odkazech v e-mailu!
PUBLIC_URL=https://feud.prece.cz
# Kde leží SQLite databáze (v Dockeru bind-mountuj na hostitele)
DATA_DIR=/data

# ---- Bezpečnost -------------------------------------------------------------
# POVINNÉ v produkci. Vygeneruj: openssl rand -hex 32
JWT_SECRET=zmen-me-na-nahodny-retezec-min-32-znaku

# ---- Admin účet (vytvoří se při prvním spuštění) ----------------------------
ADMIN_EMAIL=admin@skola.cz
ADMIN_PASSWORD=zmen-toto-heslo

# ---- SMTP pro ověřovací e-maily ---------------------------------------------
# Bez SMTP aplikace běží, ale ověřovací odkazy se jen vypisují do logu serveru.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=neodpovidat@skola.cz
SMTP_PASS=
SMTP_FROM="Family Feud <neodpovidat@skola.cz>"
